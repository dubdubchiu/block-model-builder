{
  "$defs": {
    "BlockError": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The block at fault, or null for a model-level error."
        },
        "message": {
          "description": "What happened and how to fix it.",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inside a subsystem: the inner block's key, instance/inner."
        }
      },
      "required": [
        "block",
        "message"
      ],
      "title": "BlockError",
      "type": "object"
    },
    "BlockInstance": {
      "additionalProperties": false,
      "properties": {
        "inline": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Values for unwired input ports, keyed by port name.",
          "type": "object"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "settings": {
          "additionalProperties": true,
          "description": "Values that are never wired, e.g. a Constant's value.",
          "type": "object"
        },
        "spec": {
          "description": "Block type as id@version, e.g. math.add@1.",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*@[0-9]+$",
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "spec",
        "position"
      ],
      "title": "BlockInstance",
      "type": "object"
    },
    "BlockSpec": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string"
        },
        "causal": {
          "default": true,
          "description": "False when a period's output depends on later periods (Total, NPV); such blocks can't sit inside a feedback loop.",
          "type": "boolean"
        },
        "doc": {
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "type": "string"
        },
        "impl": {
          "description": "Registered function key. Never code.",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/PortSpec"
          },
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/PortSpec"
          },
          "type": "array"
        },
        "settings": {
          "items": {
            "$ref": "#/$defs/SettingSpec"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "category",
        "doc",
        "outputs",
        "impl"
      ],
      "title": "BlockSpec",
      "type": "object"
    },
    "CompositeInput": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "targets": {
          "description": "Inner block inputs this port feeds.",
          "items": {
            "$ref": "#/$defs/PortRef"
          },
          "type": "array"
        },
        "type": {
          "default": "any",
          "description": "Port pattern shown on the subsystem block.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "targets"
      ],
      "title": "CompositeInput",
      "type": "object"
    },
    "CompositeOutput": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PortRef",
          "description": "The inner block output this port exposes."
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "CompositeOutput",
      "type": "object"
    },
    "CompositeSpec": {
      "additionalProperties": false,
      "description": "A subsystem: a reusable group of blocks with its own ports, like a LabVIEW subVI.",
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/BlockInstance"
          },
          "type": "array"
        },
        "doc": {
          "default": "",
          "type": "string"
        },
        "id": {
          "pattern": "^user\\.[a-z0-9_]+$",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/CompositeInput"
          },
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/CompositeOutput"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        },
        "wires": {
          "items": {
            "$ref": "#/$defs/Wire"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "outputs",
        "blocks",
        "wires"
      ],
      "title": "CompositeSpec",
      "type": "object"
    },
    "EvaluateResponse": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "description": "Engine name and version.",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/BlockError"
          },
          "type": "array"
        },
        "outputs": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/PortResult"
            },
            "type": "object"
          },
          "description": "Block uuid (or instance/inner for blocks inside a subsystem), then output port name, then its type and value.",
          "type": "object"
        },
        "scenario": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeline": {
          "$ref": "#/$defs/TimelineInfo"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        },
        "warnings": {
          "description": "Things to check, such as mismatched units.",
          "items": {
            "$ref": "#/$defs/BlockError"
          },
          "type": "array"
        }
      },
      "required": [
        "engine",
        "timeline",
        "outputs",
        "errors",
        "timing"
      ],
      "title": "EvaluateResponse",
      "type": "object"
    },
    "LibraryResponse": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string"
        },
        "kind_groups": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Kinds each pattern word accepts, e.g. number and integer.",
          "type": "object"
        },
        "specs": {
          "items": {
            "$ref": "#/$defs/BlockSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "engine",
        "kind_groups",
        "specs"
      ],
      "title": "LibraryResponse",
      "type": "object"
    },
    "Model": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/BlockInstance"
          },
          "type": "array"
        },
        "composites": {
          "items": {
            "$ref": "#/$defs/CompositeSpec"
          },
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "report": {
          "items": {
            "$ref": "#/$defs/ReportLine"
          },
          "type": "array"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/Scenario"
          },
          "type": "array"
        },
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "timeline": {
          "$ref": "#/$defs/Timeline"
        },
        "wires": {
          "items": {
            "$ref": "#/$defs/Wire"
          },
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "name",
        "timeline",
        "blocks",
        "wires"
      ],
      "title": "Model",
      "type": "object"
    },
    "Override": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "format": "uuid",
          "type": "string"
        },
        "inline": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "type": "object"
        },
        "settings": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "block"
      ],
      "title": "Override",
      "type": "object"
    },
    "PortRef": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "format": "uuid",
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      },
      "required": [
        "block",
        "port"
      ],
      "title": "PortRef",
      "type": "object"
    },
    "PortResult": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "Inferred type, e.g. series<currency>.",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A scalar or one value per period (or year); null when not computed or not requested."
        }
      },
      "required": [
        "type"
      ],
      "title": "PortResult",
      "type": "object"
    },
    "PortSpec": {
      "additionalProperties": false,
      "properties": {
        "doc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default inline value when the port is unwired."
        },
        "name": {
          "type": "string"
        },
        "required": {
          "default": true,
          "type": "boolean"
        },
        "type": {
          "description": "Port pattern, e.g. number, scalar<integer>, series<date>.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "PortSpec",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "ReportLine": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "format": "uuid",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      },
      "required": [
        "block",
        "port",
        "label"
      ],
      "title": "ReportLine",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "overrides": {
          "description": "Changes to top-level blocks' inline values and settings in this scenario.",
          "items": {
            "$ref": "#/$defs/Override"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "SettingSpec": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allowed values, when the setting is a choice."
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "SettingSpec",
      "type": "object"
    },
    "Timeline": {
      "additionalProperties": false,
      "properties": {
        "fiscal_year_end": {
          "default": "12-31",
          "pattern": "^[0-1][0-9]-[0-3][0-9]$",
          "type": "string"
        },
        "frequency": {
          "enum": [
            "month",
            "quarter",
            "year"
          ],
          "type": "string"
        },
        "periods": {
          "maximum": 600,
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First day of period 1; must be the first day of a month.",
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "start",
        "frequency",
        "periods"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "TimelineInfo": {
      "additionalProperties": false,
      "properties": {
        "period_labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "years": {
          "description": "Fiscal years, the columns of annual values.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "period_labels",
        "years"
      ],
      "title": "TimelineInfo",
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "properties": {
        "evaluate_ms": {
          "type": "number"
        }
      },
      "required": [
        "evaluate_ms"
      ],
      "title": "Timing",
      "type": "object"
    },
    "Wire": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/PortRef"
        },
        "to": {
          "$ref": "#/$defs/PortRef"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "from",
        "to"
      ],
      "title": "Wire",
      "type": "object"
    }
  },
  "title": "Block model builder API"
}
